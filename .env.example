# Copiez ce fichier en `.env` et renseignez vos valeurs. Ne commitez jamais `.env`.

NODE_ENV=development
PORT=4000

# MongoDB Atlas (gratuit) ou MongoDB local : mongodb://127.0.0.1:27017/torque
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@CLUSTER.mongodb.net/torque?retryWrites=true&w=majority

# Clé qui signe les jetons de connexion (32 caractères minimum, secrète, différente en production).
# Pour en générer une :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire
# Durée de validité d'une session : 30m, 12h, 7d…
JWT_EXPIRES_IN=7d

# Frais de livraison fixes par commande, en centimes d'euro (500 = 5,00 €). 0 = livraison offerte.
SHIPPING_FEE_CENTS=0

# Origines autorisées à appeler l'API (séparées par des virgules, sans slash final).
# En production, ajoutez l'URL Vercel du front-end.
CORS_ORIGINS=http://localhost:5173

# À mettre à true derrière un proxy (Render, Railway…) pour que la limitation de débit voie la vraie IP.
TRUST_PROXY=false
